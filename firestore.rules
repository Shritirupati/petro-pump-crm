rules_version = '2';

// Petrol Pump CRM: one pump per Firebase project.
// - Anyone may check whether first-time setup is done (meta/setup).
// - The first account created on the setup screen becomes the owner.
// - Only active users listed in /users can read or write data.
// - Staff can add customers and entries; only the owner can edit/delete entries,
//   delete customers, change settings or manage users.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isMember() {
      return signedIn() && exists(userDoc()) && get(userDoc()).data.active == true;
    }
    function isOwner() { return isMember() && get(userDoc()).data.role == 'owner'; }
    function setupPath() { return /databases/$(database)/documents/meta/setup; }
    // True only inside the batch that performs first-time setup for this user.
    function isFirstSetup() {
      return signedIn() && !exists(setupPath()) && getAfter(setupPath()).data.ownerUid == request.auth.uid;
    }

    function validEntry() {
      let d = request.resource.data;
      return d.customerId is string && d.date is string && d.date.size() == 10
        && d.type in ['udhar', 'jama', 'byaaj_jama', 'byaaj_maaf']
        && d.amount is number && d.amount > 0;
    }
    function validCustomer() {
      return request.resource.data.name is string && request.resource.data.name.size() > 0;
    }

    match /meta/setup {
      allow get: if true;
      allow create: if signedIn() && !exists(setupPath())
        && request.resource.data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if isOwner();
      allow create: if (isFirstSetup() && uid == request.auth.uid
          && request.resource.data.role == 'owner' && request.resource.data.active == true)
        || (isOwner() && request.resource.data.role == 'staff');
      allow update: if isOwner() && uid != request.auth.uid
        && request.resource.data.role == resource.data.role;
    }

    match /settings/main {
      allow read: if isMember();
      allow create: if isOwner() || isFirstSetup();
      allow update: if isOwner()
        || (isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastRates']));
    }

    match /customers/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && validCustomer();
      allow delete: if isOwner();
    }

    match /entries/{id} {
      allow read: if isMember();
      allow create: if isMember() && validEntry();
      allow update: if isOwner() && validEntry();
      allow delete: if isOwner();
    }
  }
}
